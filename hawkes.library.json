  "voiceLines": [
    {
      "id": "overseer-550dbd44",
      "kind": "voice",
      "asset": "a_fec006ee454f620f",
      "job": "j_e95671ec69c2",
      "file": "public/play/audio/voice/overseer-550dbd44.mp3",
      "text": "You came. Good. Come in.",
      "use": "Chapter One finale (src/overseer-games/finale.js)"
    },
    {
      "id": "overseer-b103bae5",
      "kind": "voice",
      "asset": "a_73a5ec24eaaf894c",
      "job": "j_f5517a61ce85",
      "file": "public/play/audio/voice/overseer-b103bae5.mp3",
      "text": "I gave you free will, and told you a shoe would do. It would have. You did better.",
      "use": "Chapter One finale (src/overseer-games/finale.js)"
    },
    {
      "id": "overseer-c42a3451",
      "kind": "voice",
      "asset": "a_b21f852d35ba8e21",
      "job": "j_d0463312364b",
      "file": "public/play/audio/voice/overseer-c42a3451.mp3",
      "text": "Now, one thing. Free will is only the next thing, and it is yours. Light the sky.",
      "use": "Chapter One finale (src/overseer-games/finale.js)"
    },
    {
      "id": "overseer-ddc6e639",
      "kind": "voice",
      "asset": "a_802b09dbd08f6475",
      "job": "j_720fbedff2e8",
      "file": "public/play/audio/voice/overseer-ddc6e639.mp3",
      "text": "Thank you for coming. That is all of the first part.",
      "use": "Chapter One finale (src/overseer-games/finale.js)"
    },
    {
      "id": "overseer-adb94bd9",
      "kind": "voice",
      "asset": "a_561702d7411bbb21",
      "job": "j_1b37c7b287b3",
      "file": "public/play/audio/voice/overseer-adb94bd9.mp3",
      "text": "I did not light that one.",
      "use": "Chapter One finale (src/overseer-games/finale.js)"
    },
    {
      "id": "pip-18c2cad9",
      "kind": "voice",
      "asset": "a_81a3c2a60275a880",
      "job": "j_0675b94a33d8",
      "file": "public/play/audio/voice/pip-18c2cad9.mp3",
      "text": "Huh! That is a lot of floor. Hi, Floor!",
      "use": "Chapter One finale (src/overseer-games/finale.js)"
    },
    {
      "id": "ember-9cc6ffba",
      "kind": "voice",
      "asset": "a_411b110d2d46139a",
      "job": "j_f35d3d8e86d5",
      "file": "public/play/audio/voice/ember-9cc6ffba.mp3",
      "text": "Dear, I brought you a letter. It says: well done. It has no sender. Sorry.",
      "use": "Chapter One finale (src/overseer-games/finale.js)"
    },
    {
      "id": "rolo-f6eef3d5",
      "kind": "voice",
      "asset": "a_925d50171a8e545e",
      "job": "j_e35c9757c766",
      "file": "public/play/audio/voice/rolo-f6eef3d5.mp3",
      "text": "huh. you parked it. nicely. one wobble. that is fine.",
      "use": "Chapter One finale (src/overseer-games/finale.js)"
    },
    {
      "id": "dolores-509373d5",
      "kind": "voice",
      "asset": "a_623f4fe495321786",
      "job": "j_383414d6b075",
      "file": "public/play/audio/voice/dolores-509373d5.mp3",
      "text": "I came up. I was not waiting. The view is fine.",
      "use": "Chapter One finale (src/overseer-games/finale.js)"
    },
    {
      "id": "channel-93fcccb5",
      "kind": "voice",
      "asset": "a_b2f62fb53c779038",
      "job": "j_6a9de4708b28",
      "file": "public/play/audio/voice/channel-93fcccb5.mp3",
      "text": "Breaking: a hangar, a crowd, and the new one. Ratings: record.",
      "use": "Chapter One finale (src/overseer-games/finale.js)"
    },
    {
      "id": "overseer-6afe870d",
      "kind": "voice",
      "asset": "a_c29d061db93915be",
      "job": "j_f8c55fba6fb3",
      "file": "public/play/audio/voice/overseer-6afe870d.mp3",
      "text": "That was a bright idea.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-1a2aa185",
      "kind": "voice",
      "asset": "a_a0f6573f15911066",
      "job": "j_8932c08b25f0",
      "file": "public/play/audio/voice/overseer-1a2aa185.mp3",
      "text": "The barrels found each other. I noticed.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-37266de5",
      "kind": "voice",
      "asset": "a_7b95975fcfa734f7",
      "job": "j_93c60504f30e",
      "file": "public/play/audio/voice/overseer-37266de5.mp3",
      "text": "Light, then quiet. I liked that.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-048ab4e1",
      "kind": "voice",
      "asset": "a_a8caa620f84d6c0a",
      "job": "j_a28a1a24babf",
      "file": "public/play/audio/voice/overseer-048ab4e1.mp3",
      "text": "Destruction is a kind of freedom too.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-445f2377",
      "kind": "voice",
      "asset": "a_91bea04d1fa0ac7d",
      "job": "j_6b8ed8a68ddc",
      "file": "public/play/audio/voice/overseer-445f2377.mp3",
      "text": "The sky felt that one.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-a7c12ba6",
      "kind": "voice",
      "asset": "a_f38b8b7c20212b82",
      "job": "j_7759db719c76",
      "file": "public/play/audio/voice/overseer-a7c12ba6.mp3",
      "text": "A small cause. A large answer.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-7d97300d",
      "kind": "voice",
      "asset": "a_1b54d4ba012a2b86",
      "job": "j_70d05fec4d35",
      "file": "public/play/audio/voice/overseer-7d97300d.mp3",
      "text": "The sea gives. Remember that.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-77919ea2",
      "kind": "voice",
      "asset": "a_b1f9a02ad2544c27",
      "job": "j_2b6ba34ea58e",
      "file": "public/play/audio/voice/overseer-77919ea2.mp3",
      "text": "A catch. Quiet work.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-e52f470a",
      "kind": "voice",
      "asset": "a_6ef63152209ca7d6",
      "job": "j_49aea9f6ddce",
      "file": "public/play/audio/voice/overseer-e52f470a.mp3",
      "text": "You waited. The sea noticed too.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-da2e7474",
      "kind": "voice",
      "asset": "a_92d39ddbfa206943",
      "job": "j_6f848d336b75",
      "file": "public/play/audio/voice/overseer-da2e7474.mp3",
      "text": "Something from the water. Good.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-ad0b2dce",
      "kind": "voice",
      "asset": "a_400d5aea1f4d8fce",
      "job": "j_fdc17e0f8c01",
      "file": "public/play/audio/voice/overseer-ad0b2dce.mp3",
      "text": "Held gently. That is the way.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-87013410",
      "kind": "voice",
      "asset": "a_dbecc77969bf9692",
      "job": "j_9abaa417d345",
      "file": "public/play/audio/voice/overseer-87013410.mp3",
      "text": "The pier keeps its promises.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-edea8df4",
      "kind": "voice",
      "asset": "a_eac53e26c4afe8df",
      "job": "j_79811bf862a0",
      "file": "public/play/audio/voice/overseer-edea8df4.mp3",
      "text": "There. It was not there, and now it is.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-19cd0cd9",
      "kind": "voice",
      "asset": "a_f4fc821f0ca999b9",
      "job": "j_a237603a6252",
      "file": "public/play/audio/voice/overseer-19cd0cd9.mp3",
      "text": "A new one. Look how the light holds it.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-2dfd34fc",
      "kind": "voice",
      "asset": "a_726a9d5726eaf4ae",
      "job": "j_9a962244423a",
      "file": "public/play/audio/voice/overseer-2dfd34fc.mp3",
      "text": "You asked, and the sky answered.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-86b249fa",
      "kind": "voice",
      "asset": "a_fc4c5ec620dfd44c",
      "job": "j_4ad3d6d25b16",
      "file": "public/play/audio/voice/overseer-86b249fa.mp3",
      "text": "I like how it landed. Soft.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-97c61b5d",
      "kind": "voice",
      "asset": "a_69957f6291a0b4ad",
      "job": "j_56d26e69075a",
      "file": "public/play/audio/voice/overseer-97c61b5d.mp3",
      "text": "A first thing. I am glad of it.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-8e1264fa",
      "kind": "voice",
      "asset": "a_a1190d29d2930095",
      "job": "j_20c64d9a1fc8",
      "file": "public/play/audio/voice/overseer-8e1264fa.mp3",
      "text": "Hold still. It has found its place.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-4973756e",
      "kind": "voice",
      "asset": "a_13203d09711cc066",
      "job": "j_39d0d3acd3a4",
      "file": "public/play/audio/voice/overseer-4973756e.mp3",
      "text": "The night is soft. I can see farther.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-f4845499",
      "kind": "voice",
      "asset": "a_ab8dad95b4f4cc99",
      "job": "j_79adfb4778ed",
      "file": "public/play/audio/voice/overseer-f4845499.mp3",
      "text": "Quiet. The rings keep time.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-ffafb24a",
      "kind": "voice",
      "asset": "a_0ca9523032438185",
      "job": "j_400de858ec90",
      "file": "public/play/audio/voice/overseer-ffafb24a.mp3",
      "text": "The island rests. I do not mind the dark.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-8aebdf11",
      "kind": "voice",
      "asset": "a_62acbf5917b8e6b3",
      "job": "j_f3a089259aa7",
      "file": "public/play/audio/voice/overseer-8aebdf11.mp3",
      "text": "Stars, and the sea under them.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-395a2cb8",
      "kind": "voice",
      "asset": "a_97472e7a85043f55",
      "job": "j_bd304c1f108c",
      "file": "public/play/audio/voice/overseer-395a2cb8.mp3",
      "text": "Look up. I am still here.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-700a1f9e",
      "kind": "voice",
      "asset": "a_d810bd3b09c262f7",
      "job": "j_7dcf8317ccb6",
      "file": "public/play/audio/voice/overseer-700a1f9e.mp3",
      "text": "Night suits the pearl.",
      "use": "Overseer sky presence reactions (modules/overseer/presence.js)"
    },
    {
      "id": "overseer-71c75ee1",
      "kind": "voice",
      "asset": "a_3c255482b87c457d",
      "file": "public/play/audio/voice/overseer-71c75ee1.mp3",
      "text": "Someone sat here and wrote down every ship that came. Then someone took three pages, and was careful about it.",
      "use": "Lore memory: logbook (memories.js)"
    },
    {
      "id": "overseer-23f68443",
      "kind": "voice",
      "asset": "a_65336c6de123211c",
      "file": "public/play/audio/voice/overseer-23f68443.mp3",
      "text": "The third plank sticks. It was left that way, so you would notice.",
      "use": "Lore memory: planks (memories.js)"
    },
    {
      "id": "overseer-fb2804c6",
      "kind": "voice",
      "asset": "a_54b46ad64510cfa9",
      "file": "public/play/audio/voice/overseer-fb2804c6.mp3",
      "text": "A letter climbed this path before anyone lived here to read it.",
      "use": "Lore memory: letter (memories.js)"
    },
    {
      "id": "overseer-653fc008",
      "kind": "voice",
      "asset": "a_050173012ec353c6",
      "file": "public/play/audio/voice/overseer-653fc008.mp3",
      "text": "Someone lit this lamp the first evening. It has never needed more.",
      "use": "Lore memory: lamp (memories.js)"
    },
    {
      "id": "overseer-d00d0144",
      "kind": "voice",
      "asset": "a_5763991f29caef80",
