[Unit]
Description=hawkesgen.ai portal
After=network-online.target
Wants=network-online.target

[Service]
User=hawkes
Group=hawkes
WorkingDirectory=/srv/hawkes/hawkesgenwebsite
# The cluster primary: PORTAL_WEB_PROCS web processes (default: the CPU count) on the port and one worker for every
# background loop (src/primary.ts). `systemctl reload` restarts them one at a time (deploy/pull.mjs does that).
Environment=PORTAL_ROLE=web
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/server.ts
ExecReload=/bin/kill -USR2 $MAINPID
KillMode=mixed
TimeoutStopSec=20
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/hawkes/hawkesgenwebsite/.data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
