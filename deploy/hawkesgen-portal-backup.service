[Unit]
Description=hawkesgen.ai portal: back up portal.db (hourly; the day's first copy goes to S3 when PORTAL_BACKUP_BUCKET is set)
After=network-online.target

[Service]
Type=oneshot
User=hawkes
Group=hawkes
WorkingDirectory=/srv/hawkes/hawkesgenwebsite
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/cli.ts backup
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/hawkes/hawkesgenwebsite/.data
PrivateTmp=true
