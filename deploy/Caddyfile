# hawkesgen.ai: the portal on this box, HTTPS from Let's Encrypt. Nothing else is served here; Gen, Studio and the beta
# sites live on the control server under their own names.
{
	email jgriffith3433@gmail.com
}

hawkesgen.ai {
	encode zstd gzip
	request_body {
		max_size 64MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	reverse_proxy 127.0.0.1:8800 {
		# Live job progress (server-sent events) goes out as it happens.
		flush_interval -1
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}

www.hawkesgen.ai {
	redir https://hawkesgen.ai{uri} permanent
}
