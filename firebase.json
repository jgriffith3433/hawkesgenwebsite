{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/*.br", "**/*.gz", "playtest/**"],
    "cleanUrls": false,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/home", "destination": "/index.html" },
      { "source": "/app", "destination": "/games.html" },
      { "source": "/app/studio", "destination": "/app.html" },
      { "source": "/app/g/**", "destination": "/editor.html" },
      { "source": "/app/join/**", "destination": "/games.html" },
      { "source": "/games", "destination": "/gallery.html" },
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/credits", "destination": "/credits.html" },
      { "source": "/reset", "destination": "/reset.html" },
      { "source": "/auth/popup", "destination": "/auth-popup.html" },
      { "source": "/legal", "destination": "/legal.html" },
      { "source": "/terms", "destination": "/legal.html" },
      { "source": "/privacy", "destination": "/legal.html" },
      { "source": "/refunds", "destination": "/legal.html" },
      { "source": "/connect", "destination": "/connect.html" },
      { "source": "/net", "destination": "/net.html" },
      { "source": "/thanks", "destination": "/thanks.html" },
      { "source": "/examples", "destination": "/examples.html" },
      { "source": "/entities", "destination": "/entities.html" },
      { "source": "/avatars", "destination": "/avatars.html" },
      { "source": "/community", "destination": "/community.html" },
      { "source": "/oauth/authorize", "destination": "/authorize.html" },
      { "source": "/share/new", "destination": "/share.html" },
      { "source": "/client/hawkesgen.mjs", "destination": "/hawkesgen.mjs" },
      { "source": "/v1/**", "function": { "functionId": "api", "region": "us-east4" } },
      { "source": "/mcp", "function": { "functionId": "api", "region": "us-east4" } },
      { "source": "/oauth/**", "function": { "functionId": "api", "region": "us-east4" } },
      { "source": "/.well-known/**", "function": { "functionId": "api", "region": "us-east4" } },
      { "source": "/auth/**", "function": { "functionId": "api", "region": "us-east4" } },
      { "source": "/net/**", "function": { "functionId": "api", "region": "us-east4" } },
      { "source": "/dl/**", "function": { "functionId": "api", "region": "us-east4" } },
      { "source": "/up/**", "function": { "functionId": "api", "region": "us-east4" } },
      { "source": "/s/**", "function": { "functionId": "api", "region": "us-east4" } },
      { "source": "/play/**", "function": { "functionId": "api", "region": "us-east4" } },
      { "source": "/play-asset/**", "function": { "functionId": "api", "region": "us-east4" } }
    ],
    "headers": [
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/vendor/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }, { "key": "Access-Control-Allow-Origin", "value": "*" }] },
      { "source": "/fonts/**", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
      { "source": "/play/**/*.@(mjs|glb|json)", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
      { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Strict-Transport-Security", "value": "max-age=31536000" }] }
    ]
  },
  "functions": [
    { "source": "cloud/functions", "codebase": "portal", "runtime": "nodejs24", "ignore": ["node_modules", "test", "*.log"] }
  ],
  "firestore": { "database": "(default)", "location": "us-east4", "rules": "cloud/firestore.rules", "indexes": "cloud/firestore.indexes.json" }
}
