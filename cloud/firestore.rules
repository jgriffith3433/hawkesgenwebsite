rules_version = '2';
// The portal's data is read and written only by its functions (the Admin SDK skips these rules). Browsers never reach
// Firestore directly until a collection is opened here on purpose (live feeds will be the first).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
